/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff

/*.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=31536000, immutable

/*.webm
  Content-Type: video/webm
  Cache-Control: public, max-age=31536000, immutable

/*.m4a
  Content-Type: audio/mp4
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable
